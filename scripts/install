#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

#=================================================
# INITIALIZE AND STORE SETTINGS
#=================================================

#currency=

#ynh_app_setting_set --key=currency --value=$currency

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

# Download, check integrity, uncompress and patch the source from manifest.toml
ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL DEPENDENCIES
#=================================================
ynh_script_progression "Installing dependencies..."

PNPM_VERSION=$(sed -n 's/.*"packageManager":\s*"pnpm@\([^"]*\)".*/\1/p' $install_dir/package.json)
npm install --global corepack@latest
corepack enable pnpm
corepack use pnpm@${PNPM_VERSION}

#=================================================
# APP INITIAL CONFIGURATION
#=================================================
ynh_script_progression "Adding $app's configuration files..."

ynh_config_add --template=".env" --destination="$install_dir/.env"

#=================================================
# INSTALL WISHLIST
#=================================================
ynh_script_progression "Building the app..."

pushd $install_dir
    ynh_script_progression "Installing the app..."
    export VERSION="v0.69.0"
    export SHA="f39c07db0f7a8467372bfcfdd7f5d59c035a9bd4e522996db17509bde005059c"
    ynh_exec_as_app pnpm install --frozen-lockfile

    ynh_script_progression "Sync svelte kit..."
    ynh_exec_as_app pnpm svelte-kit sync

    ynh_script_progression "Running DB migrations of the app..."
    ynh_exec_as_app pnpm prisma generate

    ynh_script_progression "Building the app..."
    ynh_exec_as_app NODE_OPTIONS="--max-old-space-size=4096" TURBO_TELEMETRY_DISABLED=1 pnpm run build

    ynh_script_progression "Prune for prod..."
    ynh_exec_as_app TURBO_TELEMETRY_DISABLED=1 pnpm prune --prod
popd

chown -R $app:$app $install_dir

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

ynh_config_add_nginx

mkdir -p /var/log/$app
chown -R $app:$app /var/log/$app

ynh_config_add_systemd --service="$app" --template="systemd.service"
yunohost service add "$app" --description="Wishlist" --log="/var/log/$app/$app.log"

#=================================================
# START SYSTEMD SERVICES
#=================================================
ynh_script_progression "Starting $app's systemd service..."

# Start systemd services
ynh_systemctl --service="$app" --action="start"

#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"