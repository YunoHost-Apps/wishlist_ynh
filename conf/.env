# If behind a reverse proxy, set this to your domain
# i.e. https://wishlist.your-domain.org
ORIGIN=https://__DOMAIN__/__PATH__
# Hours until signup and password reset tokens expire
TOKEN_TIME=72
# The currency to use when a product search does not return a currency
DEFAULT_CURRENCY=__CURRENCY__
# Set the logging level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Maxinum image size that can be uploaded (in bytes)
MAX_IMAGE_SIZE=5000000
# IPs allowed to bypass SSRF protection. Only add IPs that are trusted
ALLOWED_IPS=

# From entrypoint.sh script
PROTOCOL_HEADER=x-forwarded-proto 
HOST_HEADER=x-forwarded-host
DATABASE_URL="file:__INSTALL_DIR__/prod.db"
PUBLIC_DEFAULT_CURRENCY=__CURRENCY__
BODY_SIZE_LIMIT=5000000